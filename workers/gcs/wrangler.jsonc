{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gcs",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "workers_dev": false,
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "r2_buckets": [
    { "binding": "ARCHIVE_BUCKET", "bucket_name": "warg-archives", "preview_bucket_name": "warg-archives" }
  ]
}
// Secrets (via `wrangler secret put`):
// - INTERNAL_API_KEY: shared key for internal worker auth
// - CLOUD_FN_BASE_URL: base URL for the Cloud Function (e.g., https://us-central1-trails-e428e.cloudfunctions.net/archive-gateway)
