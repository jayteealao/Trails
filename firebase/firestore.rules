rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // End of the grace period for app-written article markers. Until this
    // instant the rules accept an app-written marker only when its key equals
    // the server-written canonicalId of the article it names; after it every
    // client marker write is refused. The committed 0 means no grace (fails
    // closed). The deploy script writes the real end (the first rules deploy
    // plus 30 days, in epoch milliseconds) into a build copy of this file.
    // Never commit a date here.
    function markerGraceEnd() {
      return timestamp.value(0); // __GRACE_END_MS__
    }

    // True when the user article named by the marker's itemId exists and its
    // server-written canonicalId equals the marker key. An article without a
    // canonicalId never matches.
    function markerKeyIsServerLink(userId, markerId) {
      let articlePath = /databases/$(database)/documents/users/$(userId)/articles/$(request.resource.data.itemId);
      return exists(articlePath)
        && get(articlePath).data.get('canonicalId', '') == markerId;
    }

    // Top-level articles collection (written by Warg backend, read-only for app).
    // A user may `get` a shared doc only if they hold a per-user marker for that
    // key. Enumeration is disabled; writes are backend-only. Markers:
    // users/{uid}/articleMarkers/{key}, written by the server (see the marker
    // rule below for the grace period).
    match /articles/{itemId} {
      allow get:   if isAuthenticated()
                   && exists(/databases/$(database)/documents/users/$(request.auth.uid)/articleMarkers/$(itemId));
      allow list:  if false;
      allow write: if false;  // Backend service account only
    }

    // Debug logs (debug builds only, temporary) — owner-scoped per uid.
    // Session docs live under debug_logs/{uid}/sessions/{sessionId}; the old
    // flat debug_logs/{sessionId} layout is intentionally denied by default.
    match /debug_logs/{userId}/sessions/{sessionId} {
      allow read, write: if isOwner(userId);
    }

    // Users collection - each user can only access their own data
    match /users/{userId} {
      // Allow users to read and write their own user document
      allow read, write: if isOwner(userId);

      // Article markers - one doc per shared article the user may read, keyed
      // by the shared id. Markers are written by the server. During the grace
      // period an app-written marker is accepted only when its key equals the
      // server-written canonicalId of the user article its itemId names; after
      // the grace end every client marker write is refused. Reads of
      // articles/{id} stay gated by the marker.
      //
      // RULES BUDGET: each client marker write reads one user article (exists()
      // and get() on one path count once), so a batch of 20 articles stays
      // within the 20-document-access limit per batched write.
      match /articleMarkers/{markerId} {
        allow read: if isOwner(userId);
        allow delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.time < markerGraceEnd()
          && request.resource.data.itemId is string
          && markerKeyIsServerLink(userId, markerId);
      }

      // Articles subcollection - user can only access their own articles
      match /articles/{articleId} {
        // Owners read, write and delete their own articles. canonicalId names
        // the shared article and only the server writes it.
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && !('canonicalId' in request.resource.data);
        allow update: if isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['canonicalId']);

        // Tags subcollection for each article
        match /tags/{tagId} {
          allow read, write: if isOwner(userId);
        }

        // Images subcollection for each article
        match /images/{imageId} {
          allow read, write: if isOwner(userId);
        }

        // Videos subcollection for each article
        match /videos/{videoId} {
          allow read, write: if isOwner(userId);
        }

        // Authors subcollection for each article
        match /authors/{authorId} {
          allow read, write: if isOwner(userId);
        }

        // Domain metadata subcollection
        match /domainMetadata/{metadataId} {
          allow read, write: if isOwner(userId);
        }

        // Large article body text (written by FirestoreBackupService to
        // text/content when the body exceeds the inline size cap; read back by
        // rehydrateLargeText). Firestore rules do not cascade from the parent
        // articles/{articleId} match, so this subcollection needs its own
        // owner-scoped grant — without it the read returned PERMISSION_DENIED
        // and full body text silently never rehydrated from the cloud.
        match /text/{textId} {
          allow read, write: if isOwner(userId);
        }

        // Domain metadata subcollection — snake_case path actually written by
        // FirestoreBackupService (DOMAIN_METADATA_COLLECTION = "domain_metadata").
        // The camelCase domainMetadata rule above matches no write path; this is
        // the one the app uses. Owner-scoped, mirroring the siblings.
        match /domain_metadata/{metadataId} {
          allow read, write: if isOwner(userId);
        }
      }

      // User settings subcollection
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}