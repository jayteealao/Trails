          { "kind": "rem", "text": "    withContext(Dispatchers.IO) { remoteArticles.chunked(50).forEach { chunk -> chunk.forEach { handleRemoteArticleChange(it) } } }" },
          { "kind": "rem", "text": "  }," },
          { "kind": "rem", "text": "  onFailure = { throw it }" },
