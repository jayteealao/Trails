  <table class="files-touched">
    <!-- @include files-touched-row { "role": "modified", "path": "android/app/src/main/java/com/jayteealao/trails/data/ArticleRepository.kt", "delta": { "add": 1, "rem": 1 } } -->
    <!-- @include files-touched-row { "role": "new", "path": "android/app/src/test/java/com/jayteealao/trails/data/FtsSearchTest.kt", "delta": { "add": 120, "rem": 0 } } -->
