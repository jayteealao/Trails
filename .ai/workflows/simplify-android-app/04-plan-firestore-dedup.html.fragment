          { "kind": "add", "text": "private fun addArticleToBatch(batch: WriteBatch, articleRef: DocumentReference, article: Article) { … }" },
          { "kind": "rem", "text": "val textSize = article.text?.toByteArray()?.size ?: 0  // inlined in backupArticle + backupArticlesPaginated" },
          { "kind": "add", "text": "addArticleToBatch(batch, articleRef, article)  // single call site" },
          { "kind": "add", "text": "private suspend inline fun <T> withAuthenticatedUser(block: suspend (FirebaseUser) -> Result<T>): Result<T> { … }" },
