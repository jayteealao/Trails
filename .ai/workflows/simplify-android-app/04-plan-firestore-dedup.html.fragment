          { "kind": "rem", "text": "private const val USERS_COLLECTION = \"users\"" },
          { "kind": "rem", "text": "private const val ARTICLES_COLLECTION = \"articles\"" },
          { "kind": "rem", "text": "val batch = firestore.batch()  // per-article tag batch (×N)" },
          { "kind": "rem", "text": "tags.forEach { tag -> val tagRef = articleRef.collection(\"tags\")… batch.set(tagRef, tag, …) }" },
          { "kind": "rem", "text": "batch.commit().await()" },
          { "kind": "add", "text": "firestoreBackupService.backupArticle(article = article, tags = tags, …).onFailure { … }" },
          { "kind": "rem", "text": "onPage = { pageArticles -> withContext(IO) { pageArticles.forEach { handleRemoteArticleChange(it) } } }  // ×2" },
          { "kind": "add", "text": "private suspend fun applyRemoteArticles(articles: List<Article>) { withContext(IO) { articles.forEach { handleRemoteArticleChange(it) } } }" },
          { "kind": "add", "text": "onPage = { pageArticles -> applyRemoteArticles(pageArticles) }  // ×2" }
        ] } -->
