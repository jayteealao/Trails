.fr-master .fr-dim-status-clean { color: #27ae60; font-weight: 600; }
.fr-master .fr-dim-status-caveats { color: #e67e22; font-weight: 600; }
.fr-master .fr-fix-notice { padding: 10px 14px; background: #eafff0; border-left: 3px solid #27ae60; border-radius: 4px; font-size: 13px; margin-bottom: 16px; }
