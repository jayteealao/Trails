<section class="fragment-review-dimension" data-artifact="review-dimension" data-dimension="reliability" data-rev="2">
<style>
.rd-root { font-family: inherit; }
.rd-pills { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
.rd-pill {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 4px 12px; border-radius: 20px; cursor: pointer;
  border: 1.5px solid transparent; font-size: 0.8rem; font-weight: 600;
  letter-spacing: 0.03em; transition: opacity 0.15s, border-color 0.15s;
  background: var(--rd-pill-bg, #eee); color: var(--rd-pill-fg, #333);
}
.rd-pill[data-active="true"] { border-color: currentColor; }
.rd-pill[data-sev="HIGH"]   { --rd-pill-bg: #ffe0de; --rd-pill-fg: #b71c1c; }
.rd-pill[data-sev="LOW"]    { --rd-pill-bg: #e8f5e9; --rd-pill-fg: #1b5e20; }
.rd-pill[data-sev="ALL"]    { --rd-pill-bg: #e8eaf6; --rd-pill-fg: #283593; }
@media (prefers-color-scheme: dark) {
  .rd-pill[data-sev="HIGH"] { --rd-pill-bg: #4a0f0c; --rd-pill-fg: #ff8a80; }
  .rd-pill[data-sev="LOW"]  { --rd-pill-bg: #0a2e0d; --rd-pill-fg: #69f0ae; }
  .rd-pill[data-sev="ALL"]  { --rd-pill-bg: #1a1d3a; --rd-pill-fg: #8c9eff; }
}
:root[data-theme="dark"] .rd-pill[data-sev="HIGH"] { --rd-pill-bg: #4a0f0c; --rd-pill-fg: #ff8a80; }
:root[data-theme="dark"] .rd-pill[data-sev="LOW"]  { --rd-pill-bg: #0a2e0d; --rd-pill-fg: #69f0ae; }
:root[data-theme="dark"] .rd-pill[data-sev="ALL"]  { --rd-pill-bg: #1a1d3a; --rd-pill-fg: #8c9eff; }

.rd-tbl { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
.rd-tbl th {
  text-align: left; padding: 8px 10px; cursor: pointer;
  border-bottom: 2px solid var(--color-border, #ccc);
  user-select: none; white-space: nowrap;
  color: var(--color-text-secondary, #666);
}
.rd-tbl th:hover { color: var(--color-text, #111); }
.rd-sort-icon { font-style: normal; margin-left: 3px; opacity: 0.45; }
th[aria-sort="ascending"]  .rd-sort-icon::after { content: " ▲"; opacity: 1; }
th[aria-sort="descending"] .rd-sort-icon::after { content: " ▼"; opacity: 1; }
.rd-tbl tr.rd-row { border-bottom: 1px solid var(--color-border, #eee); }
.rd-tbl tr.rd-row td { padding: 9px 10px; vertical-align: top; }
.rd-tbl tr.rd-row:hover td { background: var(--color-surface-hover, rgba(0,0,0,.04)); }
.rd-chip {
  display: inline-block; padding: 2px 7px; border-radius: 4px;
  font-size: 0.73rem; font-weight: 700; white-space: nowrap;
}
.rd-chip-HIGH  { background: #ffe0de; color: #b71c1c; }
.rd-chip-LOW   { background: #e8f5e9; color: #1b5e20; }
.rd-chip-fixed { background: #e3f2fd; color: #0d47a1; }
.rd-chip-open  { background: #fff8e1; color: #e65100; }
@media (prefers-color-scheme: dark) {
  .rd-chip-HIGH  { background: #4a0f0c; color: #ff8a80; }
  .rd-chip-LOW   { background: #0a2e0d; color: #69f0ae; }
  .rd-chip-fixed { background: #0d1f38; color: #64b5f6; }
  .rd-chip-open  { background: #2d1f00; color: #ffcc80; }
}
:root[data-theme="dark"] .rd-chip-HIGH  { background: #4a0f0c; color: #ff8a80; }
:root[data-theme="dark"] .rd-chip-LOW   { background: #0a2e0d; color: #69f0ae; }
:root[data-theme="dark"] .rd-chip-fixed { background: #0d1f38; color: #64b5f6; }
:root[data-theme="dark"] .rd-chip-open  { background: #2d1f00; color: #ffcc80; }

.rd-expand-btn {
  background: none; border: none; padding: 0; cursor: pointer;
  font-size: 0.78rem; color: var(--color-link, #1565c0); text-decoration: underline;
}
tr.rd-detail { display: none; }
tr.rd-detail.rd-open { display: table-row; }
tr.rd-detail td {
  background: var(--color-surface-subtle, #f7f8fa);
  padding: 12px 16px; font-size: 0.81rem;
  border-bottom: 2px solid var(--color-border, #ddd);
}
@media (prefers-color-scheme: dark) {
  tr.rd-detail td { background: #1a1a1a; }
}
:root[data-theme="dark"] tr.rd-detail td { background: #1a1a1a; }
.rd-detail pre {
  overflow-x: auto;
  background: var(--color-code-bg, #f0f0f0);
  border-radius: 4px; padding: 8px 12px;
  font-size: 0.77rem; margin: 6px 0; white-space: pre;
}
@media (prefers-color-scheme: dark) { .rd-detail pre { background: #111; } }
:root[data-theme="dark"] .rd-detail pre { background: #111; }
.rd-lbl { font-weight: 600; color: var(--color-text-secondary, #666); margin-bottom: 2px; margin-top: 10px; }
.rd-lbl:first-child { margin-top: 0; }
.rd-fix-box {
  margin-top: 10px; padding: 10px 14px;
  border-left: 3px solid #1565c0;
  background: var(--color-surface-subtle, #eef3ff);
  border-radius: 0 4px 4px 0;
}
@media (prefers-color-scheme: dark) {
  .rd-fix-box { background: #0a1529; border-left-color: #64b5f6; }
}
:root[data-theme="dark"] .rd-fix-box { background: #0a1529; border-left-color: #64b5f6; }
.rd-no-results { padding: 20px; text-align: center; color: var(--color-text-secondary, #888); }
</style>

<div class="rd-root">
  <div class="rd-pills" id="rd-pills">
    <button class="rd-pill" data-sev="ALL" data-active="true">All open (1)</button>
    <button class="rd-pill" data-sev="LOW">LOW (1)</button>
  </div>

  <div style="overflow-x:auto;">
    <table class="rd-tbl" id="rd-tbl" aria-label="Open reliability findings">
      <thead>
        <tr>
          <th data-col="id" aria-sort="none">ID<i class="rd-sort-icon"></i></th>
          <th data-col="sev" aria-sort="none">Sev<i class="rd-sort-icon"></i></th>
          <th data-col="conf" aria-sort="none">Conf<i class="rd-sort-icon"></i></th>
          <th data-col="status" aria-sort="none">Status<i class="rd-sort-icon"></i></th>
          <th data-col="pre" aria-sort="none">Pre<i class="rd-sort-icon"></i></th>
          <th>Location</th>
          <th>Issue</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="rd-tbody"></tbody>
    </table>
    <p id="rd-no-results" class="rd-no-results" style="display:none;">No findings match the current filter.</p>
  </div>
</div>

<script>
(function() {
  var sec = document.currentScript.closest('.fragment-review-dimension');

  var FINDINGS = [
    {
      id: 'RE-2',
      sev: 'LOW',
      conf: 'Med',
      status: 'open',
      pre: true,
      file: 'FirestoreSyncManager.kt:579-583',
      issue: 'reconcileNeverBackedUpArticles stops on first chunk failure',
      surfaced: '2026-07-06',
      lastSeen: '2026-07-11',
      evidence: 'onFailure = { e ->\n    Timber.w(e, "reconcile: backup failed for chunk, stopping sweep")\n    return\n}',
      desc: 'A transient network error for one chunk silently stops the reconcile sweep. Subsequent never-backed-up articles are not processed until the next periodic sync cycle (~15 min). Code rewritten by 249eb41; behavior unchanged. Re-anchored from lines 538-542 to 579-583.',
      fix: 'Log the failure, increment a failureCount, and continue to the next chunk rather than returning. Track total chunk failures and log them at sweep end.'
    }
  ];
  // RE-3 (HIGH) was fixed in the review fix loop (commit 8b06e84) — OPEN findings only are listed here; history lives in the .md.

  var sevOrder = { HIGH: 0, MED: 1, LOW: 2, NIT: 3 };
  var activeFilter = 'ALL';
  var sortCol = null;
  var sortAsc = true;

  function esc(s) {
    return String(s)
      .replace(/&/g,'&amp;')
      .replace(/</g,'&lt;')
      .replace(/>/g,'&gt;')
      .replace(/"/g,'&quot;');
  }

  function filtered() {
    if (activeFilter === 'ALL') return FINDINGS.slice();
    return FINDINGS.filter(function(f) { return f.sev === activeFilter; });
  }

  function sorted(rows) {
    if (!sortCol) return rows;
    return rows.slice().sort(function(a, b) {
      var va = a[sortCol], vb = b[sortCol];
      if (sortCol === 'sev') { va = sevOrder[va] !== undefined ? sevOrder[va] : 99; vb = sevOrder[vb] !== undefined ? sevOrder[vb] : 99; }
      if (sortCol === 'pre') { va = va ? 1 : 0; vb = vb ? 1 : 0; }
      if (va < vb) return sortAsc ? -1 : 1;
      if (va > vb) return sortAsc ? 1 : -1;
      return 0;
    });
  }

  function render() {
    var tbody = sec.querySelector('#rd-tbody');
    var noRes = sec.querySelector('#rd-no-results');
    var rows = sorted(filtered());
    if (!rows.length) {
      tbody.innerHTML = '';
      noRes.style.display = '';
      return;
    }
    noRes.style.display = 'none';
    tbody.innerHTML = rows.map(function(f) {
      return [
        '<tr class="rd-row" data-id="' + f.id + '">',
        '  <td><strong>' + esc(f.id) + '</strong></td>',
        '  <td><span class="rd-chip rd-chip-' + esc(f.sev) + '">' + esc(f.sev) + '</span></td>',
        '  <td>' + esc(f.conf) + '</td>',
        '  <td><span class="rd-chip rd-chip-' + esc(f.status) + '">' + esc(f.status) + '</span></td>',
        '  <td>' + (f.pre ? 'yes' : 'no') + '</td>',
        '  <td style="font-family:monospace;font-size:0.77rem;word-break:break-all;">' + esc(f.file) + '</td>',
        '  <td>' + esc(f.issue) + '</td>',
        '  <td><button class="rd-expand-btn" data-target="' + f.id + '-det">Details</button></td>',
        '</tr>',
        '<tr class="rd-detail" id="' + f.id + '-det">',
        '  <td colspan="8">',
        '    <div class="rd-lbl">Evidence</div>',
        '    <pre>' + esc(f.evidence) + '</pre>',
        '    <div class="rd-lbl">Issue</div>',
        '    <p style="margin:4px 0;">' + esc(f.desc) + '</p>',
        '    <div class="rd-fix-box"><div class="rd-lbl" style="margin-top:0;">Fix</div><p style="margin:4px 0;">' + esc(f.fix) + '</p></div>',
        '    <p style="margin-top:8px;font-size:0.74rem;color:var(--color-text-secondary,#888);">Surfaced: ' + esc(f.surfaced) + ' &nbsp;|&nbsp; Last seen: ' + esc(f.lastSeen) + '</p>',
        '  </td>',
        '</tr>'
      ].join('\n');
    }).join('\n');

    tbody.querySelectorAll('.rd-expand-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var det = sec.querySelector('#' + btn.dataset.target);
        var open = det.classList.toggle('rd-open');
        btn.textContent = open ? 'Hide' : 'Details';
      });
    });
  }

  sec.querySelector('#rd-pills').addEventListener('click', function(e) {
    var pill = e.target.closest('.rd-pill');
    if (!pill) return;
    activeFilter = pill.dataset.sev;
    sec.querySelectorAll('.rd-pill').forEach(function(p) {
      p.dataset.active = String(p === pill);
    });
    render();
  });

  sec.querySelector('#rd-tbl').addEventListener('click', function(e) {
    var th = e.target.closest('th[data-col]');
    if (!th) return;
    var col = th.dataset.col;
    if (col === sortCol) { sortAsc = !sortAsc; }
    else { sortCol = col; sortAsc = true; }
    sec.querySelectorAll('th[data-col]').forEach(function(h) { h.removeAttribute('aria-sort'); });
    th.setAttribute('aria-sort', sortAsc ? 'ascending' : 'descending');
    render();
  });

  render();

  window.dispatchEvent(new CustomEvent('sdlc:fragment-ready', {
    detail: {
      name: 'review-dimension',
      artifact: 'review-dimension',
      dimension: 'reliability',
      counts: { findings: 1, blockers: 0 }
    }
  }));
})();
</script>
</section>
