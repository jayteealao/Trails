{
  "functions": [
    {
      "source": ".",
      "codebase": "user-triggers",
      "runtime": "nodejs22",
      "predeploy": ["npm run build"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8081
    },
    "ui": {
      "enabled": true
    }
  }
}
