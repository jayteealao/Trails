{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "singlefile",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "workers_dev": false,
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "browser": { "binding": "MYBROWSER" },
  "r2_buckets": [
    { "binding": "ARCHIVE_BUCKET", "bucket_name": "warg-archives", "preview_bucket_name": "warg-archives" }
  ],
  // Required secrets, set with `wrangler secret put`; scripts/deploy.sh checks the same names.
  "secrets": { "required": ["INTERNAL_API_KEY"] }
}
// Secrets (via `wrangler secret put`):
// - INTERNAL_API_KEY: shared key for internal worker auth
