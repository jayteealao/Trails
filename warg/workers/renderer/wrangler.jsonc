{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "renderer",
  "main": "src/index.ts",
  // Equals COMPATIBILITY_DATE in ../compatibility-date.mjs; scripts/check-worker-configs.mjs fails otherwise.
  "compatibility_date": "2026-03-24",
  "workers_dev": false,
  // Workers tracing: the runtime emits the spans; enabled alone turns on logs only.
  "observability": { "enabled": true, "traces": { "enabled": true } },
  // Browser Rendering through the binding: no API token, one quickAction() per page load.
  "browser": { "binding": "BROWSER" },
  "r2_buckets": [
    { "binding": "ARCHIVE_BUCKET", "bucket_name": "warg-archives" }
  ],
  // Required secrets, set with `cf workers secrets update`; scripts/deploy.sh checks the same names.
  "secrets": {
    "required": ["INTERNAL_API_KEY"]
  }
}
// Secrets (via `cf workers secrets update`):
// - INTERNAL_API_KEY: shared key for internal worker auth
