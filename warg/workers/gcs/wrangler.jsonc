{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gcs",
  "main": "src/index.ts",
  // Equals COMPATIBILITY_DATE in ../compatibility-date.mjs; scripts/check-worker-configs.mjs fails otherwise.
  "compatibility_date": "2026-03-24",
  "workers_dev": false,
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "r2_buckets": [
    { "binding": "ARCHIVE_BUCKET", "bucket_name": "warg-archives", "preview_bucket_name": "warg-archives" }
  ],
  // Required secrets, set with `cf workers secrets update`; scripts/deploy.sh checks the same names.
  "secrets": { "required": ["INTERNAL_API_KEY", "ARCHIVE_GATEWAY_KEY", "CLOUD_FN_BASE_URL"] }
}
// Secrets (via `cf workers secrets update`):
// - INTERNAL_API_KEY: shared key for internal worker auth
// - ARCHIVE_GATEWAY_KEY: this worker's own key for the archive-gateway cloud function
// - CLOUD_FN_BASE_URL: base URL for the Cloud Function (e.g., https://us-central1-trails-e428e.cloudfunctions.net/archive-gateway)
