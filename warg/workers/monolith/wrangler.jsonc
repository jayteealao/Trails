// Deploys read cloudflare.config.ts (cf deploy); its `exports` lifecycle
// declaration replaces the `migrations` array below. This file serves
// `wrangler dev` (cf dev rejects the container Durable Object) and
// `wrangler types`. Change a binding in both files.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monolith",
  "main": "src/index.ts",
  // Equals COMPATIBILITY_DATE in ../compatibility-date.mjs; scripts/check-worker-configs.mjs fails otherwise.
  "compatibility_date": "2026-03-24",
  "workers_dev": false,
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "R2_BUCKET_NAME": "warg-archives"
  },
  "r2_buckets": [
    { "binding": "ARCHIVE_BUCKET", "bucket_name": "warg-archives", "preview_bucket_name": "warg-archives" }
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      // Bumped lite (256 MiB) -> standard-1 (4 GiB) to test whether better-resourced
      // containers provision more reliably (createSession 500s) and avoid OOM when
      // monolith base64-inlines heavy pages. ("standard" is the deprecated alias.)
      "instance_type": "standard-1",
      "max_instances": 5
      // Lifecycle: containers are stopped per job (stop() in a finally block in
      // src/index.ts) with a 5m sleepAfter backstop set on the Sandbox subclass
      // there — wrangler's containers config has no sleep_after key.
    }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "Sandbox", "name": "Sandbox" }
    ]
  },
  "migrations": [
    { "new_sqlite_classes": ["Sandbox"], "tag": "v1" }
  ],
  // Required secrets, set with `wrangler secret put`; scripts/deploy.sh checks the same names.
  "secrets": { "required": ["INTERNAL_API_KEY", "R2_ACCOUNT_ID", "R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY"] }
}
// Secrets (via `wrangler secret put`):
// - INTERNAL_API_KEY: shared key for internal worker auth
// - MONOLITH_SERVICE_URL (optional): fallback HTTP service URL
//   Not in secrets.required, so `wrangler dev` ignores a .dev.vars entry for it;
//   pass it as `wrangler dev --var MONOLITH_SERVICE_URL:<url>` to try the fallback.
// R2 S3-API presign secrets (B1b) — required; create an R2 API token with
// Object Read and Write scoped to warg-archives in the Cloudflare dashboard.
// The presigned GET reads the input and the presigned PUT writes the output:
// - R2_ACCOUNT_ID: Cloudflare account id (R2 S3 endpoint host prefix)
// - R2_ACCESS_KEY_ID: R2 access key id
// - R2_SECRET_ACCESS_KEY: R2 secret access key
