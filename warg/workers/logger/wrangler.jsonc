// Deploys read cloudflare.config.ts (cf deploy); its `exports` lifecycle
// declaration replaces the `migrations` array below. This file serves
// `wrangler types`, the Workers-pool unit tests (vitest.config.ts) and the
// browser checks' `wrangler dev` (it needs --persist-to, which cf dev
// lacks). Change a binding in both files.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "logger",
  "main": "src/index.ts",
  // Equals COMPATIBILITY_DATE in ../compatibility-date.mjs; scripts/check-worker-configs.mjs fails otherwise.
  "compatibility_date": "2026-03-24",
  "workers_dev": false,
  "durable_objects": {
    "bindings": [{ "name": "LOGGER_DO", "class_name": "LoggerDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LoggerDO"] }],
  "d1_databases": [
    {
      "binding": "INDEX_DB",
      "database_name": "warg-requests-index",
      "database_id": "ff077e87-293b-4434-ad9e-ab669c9cbabb"
    }
  ],
  "observability": { "enabled": true },
  // Required secrets, set with `cf workers secrets update`; scripts/deploy.sh checks the same names.
  "secrets": { "required": ["INTERNAL_API_KEY"] }
}
