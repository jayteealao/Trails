// Deploys read cloudflare.config.ts (cf deploy); its `exports` lifecycle
// declaration replaces the `migrations` array below. This file serves
// `wrangler types` and the browser checks' `wrangler dev` (it needs
// --persist-to, which cf dev lacks). Change a binding in both files.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workflow",
  "main": "src/index.ts",
  // Equals COMPATIBILITY_DATE in ../compatibility-date.mjs; scripts/check-worker-configs.mjs fails otherwise.
  "compatibility_date": "2026-03-24",
  "workers_dev": false,
  // Workers tracing: the runtime emits the spans; enabled alone turns on logs only.
  "observability": { "enabled": true, "traces": { "enabled": true } },

  // Cloudflare Workflows
  "workflows": [
    {
      "name": "archive-workflow",
      "binding": "ARCHIVE_WORKFLOW",
      "class_name": "ArchiveWorkflow"
    }
  ],

  // Durable Objects for browser quota management
  "durable_objects": {
    "bindings": [
      { "name": "BROWSER_QUOTA", "class_name": "BrowserQuotaDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_classes": ["BrowserQuotaDO"] }
  ],

  // Service bindings for internal workers
  "services": [
    { "binding": "LOGGER", "service": "logger" },
    { "binding": "RENDERER", "service": "renderer" },
    { "binding": "HYPERRENDERER", "service": "hyperrenderer" },
    { "binding": "SINGLEFILE", "service": "singlefile" },
    { "binding": "READABILITY", "service": "readability" },
    { "binding": "MONOLITH", "service": "monolith" },
    { "binding": "GCS", "service": "gcs" }
  ],

  // Workers AI: converts the cleaned Readability HTML to the AI Markdown artifact
  "ai": { "binding": "AI" },

  // R2 bucket for artifacts
  "r2_buckets": [
    { "binding": "ARCHIVE_BUCKET", "bucket_name": "warg-archives" }
  ],

  // Environment variables
  "vars": {
    "MOCK_PIPELINE": "false"
  },
  // Required secrets, set with `cf workers secrets update`; scripts/deploy.sh checks the same names.
  "secrets": { "required": ["INTERNAL_API_KEY"] }
}
