#!/usr/bin/env bash
# Stub of firebase-tools for scripts/deploy-harness/run.sh: logs the arguments
# and the GIT_SHA the bundle build would bake; runs no predeploy. A rules
# deploy (run from deploy.sh's build folder) keeps the uploaded Firestore file
# as uploaded-firestore.rules and releases both files into the state folder,
# where the curl stub serves them as the Rules API.
#   H_FIREBASE_RC=<n>   exit code of `firebase deploy` (default 0)
#   HARNESS_FIREBASE_UNAUTH=1   `login:list` reports no account (exit 0, as the real tool does)
#   H_RULES_NOOP=1      a rules deploy exits 0 and releases nothing
#   H_RULES_DRIFT=storage   the released storage rules gain one line
set -euo pipefail
state="${HARNESS_STATE:?HARNESS_STATE is not set}"
echo "firebase $* GIT_SHA=${GIT_SHA:-}" >>"$state/calls.log"
if [ "${1:-}" = "login:list" ]; then
  if [ "${HARNESS_FIREBASE_UNAUTH:-0}" = 1 ]; then
    echo 'No authorized accounts, run "firebase login"'
    exit 0
  fi
  echo "Logged in as harness@example.invalid"
  exit 0
fi
if [ "${1:-} ${2:-} ${3:-}" = "deploy --only firestore:rules,storage" ]; then
  cp firestore.rules "$state/uploaded-firestore.rules"
  if [ "${H_RULES_NOOP:-0}" != 1 ]; then
    cp firestore.rules "$state/released-firestore.rules"
    cp storage.rules "$state/released-storage.rules"
    if [ "${H_RULES_DRIFT:-}" = storage ]; then
      echo "// drift" >>"$state/released-storage.rules"
    fi
  fi
fi
echo "Deploy complete!"
exit "${H_FIREBASE_RC:-0}"
