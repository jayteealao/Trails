#!/usr/bin/env bash
# Stub of wrangler for scripts/deploy-harness/run.sh: `pages deploy` records
# its --commit-hash and --branch for the cf stub's Pages deployment list.
#   HARNESS_WRANGLER_UNAUTH=1   `whoami` fails as when nobody is signed in
set -euo pipefail
state="${HARNESS_STATE:?HARNESS_STATE is not set}"
echo "wrangler $*" >>"$state/calls.log"
if [ "${1:-}" = "whoami" ]; then
  if [ "${HARNESS_WRANGLER_UNAUTH:-0}" = 1 ]; then
    echo "You are not authenticated. Please run 'wrangler login'." >&2
    exit 1
  fi
  echo "You are logged in with an OAuth Token, associated with the email harness@example.invalid."
  exit 0
fi
if [ "${1:-} ${2:-}" = "pages deploy" ]; then
  while [ $# -gt 0 ]; do
    [ "$1" = "--commit-hash" ] && printf '%s\n' "${2:-}" >"$state/pages-hash"
    [ "$1" = "--branch" ] && printf '%s\n' "${2:-}" >"$state/pages-branch"
    shift
  done
  echo "Deployment complete!"
  exit "${H_WRANGLER_RC:-0}"
fi
echo "wrangler stub: unhandled command" >&2
exit 64
