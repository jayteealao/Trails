#!/usr/bin/env bash
# Stub of wrangler for scripts/deploy-harness/run.sh. deploy.sh never runs
# wrangler (every Cloudflare step goes through cf), so any call is recorded
# for the scenarios that assert none happened, and fails.
set -euo pipefail
state="${HARNESS_STATE:?HARNESS_STATE is not set}"
echo "wrangler $*" >>"$state/calls.log"
echo "wrangler stub: deploy.sh must not run wrangler" >&2
exit 64
