{
  "name": "@warg/dashboard-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build:test": "tsc",
    "build:deploy": "node ../../scripts/build-function-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build:test && node --test \"dist/__tests__/*.test.js\"",
    "serve": "firebase emulators:start --only functions",
    "deploy": "node -e \"console.error('Deploy Cloud Functions with scripts/deploy.sh: from warg/, run pnpm deploy:all or bash scripts/deploy.sh --with-functions');process.exit(1)\""
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@google-cloud/storage": "7.21.0",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "^5.7.3"
  }
}
