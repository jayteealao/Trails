{
  "name": "@warg/backfill-scripts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Admin-SDK maintenance CLIs for the article-marker rollout: bulk marker backfill, a per-user coverage gate, and legacy debug_logs cleanup. Single-user scoped, dry-run-first, never destructive in the backfill path.",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build:deps": "pnpm --filter @warg/user-triggers run build:link",
    "build": "pnpm run build:deps && tsc",
    "typecheck": "pnpm run build:deps && tsc --noEmit",
    "test": "pnpm run build && node --test \"dist/__tests__/*.unit.test.js\"",
    "test:integration": "pnpm run build:deps && vitest run --config vitest.integration.config.ts",
    "backfill": "node dist/marker-backfill.js",
    "gate": "node dist/coverage-gate.js",
    "cleanup": "node dist/debug-logs-cleanup.js",
    "merge": "node dist/merge-pass-a.js",
    "rederive": "node dist/rederive-pass-b.js"
  },
  "dependencies": {
    "firebase-admin": "14.5.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@warg/url-normalizer": "workspace:*",
    "@warg/user-triggers": "workspace:*",
    "typescript": "^5.7.0",
    "vitest": "4.1.10"
  }
}
