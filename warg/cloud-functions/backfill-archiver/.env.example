# Warg Gateway Configuration
# PUBLIC_API_KEY, INTERNAL_API_KEY, ARCHIVE_GATEWAY_KEY, GATEWAY_LOG_KEY, DASHBOARD_API_KEY,
# BACKFILL_STATUS_KEY, CF_ACCESS_CLIENT_ID and CF_ACCESS_CLIENT_SECRET are
# Secret Manager secrets (firebase functions:secrets:set <NAME>). They never go in .env.
# true also accepts the old shared INTERNAL_API_KEY during a key rotation (README: rotating the function keys).
KEY_ROTATION_DUAL_ACCEPT=false
GATEWAY_URL=https://gateway.jayteealao.workers.dev
# Required: the Firebase uid whose saved articles the backfill archives. No default.
BACKFILL_USER_ID=
