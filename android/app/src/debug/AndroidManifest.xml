<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Debug-only manifest override for instrumented characterization tests.

      Instrumented tests run against `HiltTestApplication` (via HiltTestRunner), whose Hilt
      component is created lazily by `HiltAndroidRule` inside each test — not at process
      start. `FirestoreSyncInitializer` is an androidx.startup Initializer that runs at
      `InitializationProvider.onCreate()` (before Application.onCreate) and calls
      `EntryPointAccessors.fromApplication(...)`. Under the test application that access
      throws "The component was not created. Check that you have added the HiltAndroidRule",
      crashing the app process before any test can run (Room+Hilt smoke test / NavigationTest).

      Removing the initializer from App Startup for the debug build type (the build type
      instrumented tests assemble) lets the test application boot cleanly; the Hilt graph is
      then built by the test's own `HiltAndroidRule`. In production (release), the real
      `@HiltAndroidApp` app creates its component on demand, so the initializer runs normally
      and this override does not apply. Debug developer builds still schedule periodic sync
      from `Trails.onCreate()`; only the initializer's auth-state listener/logging is skipped.
    -->
    <application>
        <!-- Debug only: holds one Settings sync or unsynced-changes dialog state for device
             captures (adb shell am start -n <app>/.debug.DesignStatesActivity ...). -->
        <activity
            android:name="com.jayteealao.trails.debug.DesignStatesActivity"
            android:exported="true"
            android:theme="@style/Theme.Trails" />

        <!-- Debug only: makes a better text source arrive while the Reader is open.
             adb shell am broadcast -n com.jayteealao.trails/.debug.ReaderFixtureReceiver -a com.jayteealao.trails.debug.READER_SEED
             adb shell am broadcast -n com.jayteealao.trails/.debug.ReaderFixtureReceiver -a com.jayteealao.trails.debug.READER_ARRIVE
             with the string extra itemId, for example text-first-r1, stores the Readability archive for
             that article instead, so the first text arrives while the Reader waits.
             adb shell am broadcast -n com.jayteealao.trails/.debug.ReaderFixtureReceiver -a com.jayteealao.trails.debug.READER_SEED_EMPTY
             with the string extra itemId, for example text-first-a1 (an XML comment cannot hold a double hyphen).
             adb shell am broadcast -n com.jayteealao.trails/.debug.ReaderFixtureReceiver -a com.jayteealao.trails.debug.READER_SEED_ALL_ARCHIVES
             stores an article with every local archive, so the detail screen shows every tab.
             adb shell am broadcast -n com.jayteealao.trails/.debug.ReaderFixtureReceiver -a com.jayteealao.trails.debug.READER_SEED_WORST
             stores the worst article for the reading column: a five-line title, a broken image,
             a long unbroken URL and a body of over 20,000 words. -->
        <receiver
            android:name="com.jayteealao.trails.debug.ReaderFixtureReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.jayteealao.trails.debug.READER_SEED" />
                <action android:name="com.jayteealao.trails.debug.READER_ARRIVE" />
                <action android:name="com.jayteealao.trails.debug.READER_SEED_EMPTY" />
                <action android:name="com.jayteealao.trails.debug.READER_SEED_ALL_ARCHIVES" />
                <action android:name="com.jayteealao.trails.debug.READER_SEED_WORST" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.jayteealao.trails.sync.initializers.FirestoreSyncInitializer"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
